# Environment variables - never upload these.
# Glob, not a literal name: .env.bak sat here untracked for two days
# holding live Twilio/Gmail/Anthropic credentials, and only luck kept
# it out of a commit.
.env*

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/

# Mac system files
.DS_Store

# Google Cloud
*.json
service-account-key.json

# Cursor
.cursor/
# Scratch folder for files handed over from Claude sessions
Claude outputs/
